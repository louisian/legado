<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialogue_color_config"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/sw_enable_dialogue_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_dialogue_color"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:id="@+id/ll_dialogue_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialogue_color" />

        <io.legado.app.lib.theme.view.ThemeButton
            android:id="@+id/btn_dialogue_color"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="@string/select_color" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialogue_pattern_hint"
        android:layout_marginTop="16dp"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_dialogue_pattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="[「『&quot;&quot;''].*?[」』&quot;&quot;'']"
        android:inputType="text"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialogue_pattern_example"
        android:textSize="11sp"
        android:textColor="@color/secondaryText"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <io.legado.app.lib.theme.view.ThemeButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <io.legado.app.lib.theme.view.ThemeButton
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/ok" />
    </LinearLayout>

</LinearLayout>